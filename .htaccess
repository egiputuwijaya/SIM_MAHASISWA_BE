# ============================================================
# sim_mahasiswa_be/.htaccess
# URL Rewriting (Clean URL / Front Controller)
# Semua request yang bukan file/folder nyata dialihkan ke index.php
# ============================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Teruskan header Authorization ke PHP (Apache + PHP-FPM/CGI sering menyembunyikannya)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Izinkan akses langsung ke file/folder yang ada (foto di uploads/, dll)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Front Controller: semua request API jatuh ke index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Larang akses langsung ke file .env (berisi kredensial)
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Larang akses ke file backup/source (biasa berakhir .bak, .sql, ~, dsb.)
<FilesMatch "\.(bak|sql|log|ini|sh|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
