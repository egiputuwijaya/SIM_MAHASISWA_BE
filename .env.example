# =====================================================================
# .env.example — template konfigurasi SIM Mahasiswa BE
#
# Cara pakai:
#   cp .env.example .env    (lokal)
#   lalu isi nilainya di .env  (file .env TIDAK ikut di-commit)
#
# Di hosting: salin ke .env lewat File Manager (aktifkan Show Hidden
# Files) atau unggah langsung, lalu isi sesuai kredensial cPanel.
# =====================================================================

# --- Database (PDO, utf8mb4) -----------------------------------------
# Lokal:    DB_HOST=127.0.0.1, DB_USER=root
# Hosting:  DB_HOST=localhost, DB_NAME/DB_USER biasanya ber-prefix
#           username cPanel, mis. userxxx_sim_mahasiswa / userxxx_
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sim_mahasiswa
DB_USER=root
DB_PASS=

# --- Aplikasi ---------------------------------------------------------
APP_NAME="SIM Mahasiswa API"
# production | development
APP_ENV=production
# Wajib false di hosting. true membocorkan pesan error DB ke client.
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# URL publik aplikasi TANPA /api/v1, dipakai membangun foto_url.
# Lokal:    http://localhost:8000
# Hosting:  https://domain-anda.com        (di subfolder: https://domain-anda.com/api)
APP_BASE_URL=http://localhost:8000

# WAJIB diganti: string acak minimal 32 karakter (tanda tangan HMAC token).
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# --- Autentikasi ------------------------------------------------------
# Masa berlaku token dalam detik (default 3600 = 1 jam)
AUTH_TOKEN_TTL=3600

# --- CORS -------------------------------------------------------------
# Origin frontend yang diizinkan, dipisah koma.
# Default * hanya untuk development; di produksi ganti, mis.:
# CORS_ALLOWED_ORIGINS=https://frontend-anda.com,https://appanda.com
CORS_ALLOWED_ORIGINS=*

# --- Upload foto ------------------------------------------------------
# Ukuran maksimal dalam KB (2048 = 2 MB)
UPLOAD_MAX_SIZE=2048
UPLOAD_ALLOWED_EXT=jpg,jpeg,png
